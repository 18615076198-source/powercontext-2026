# ---- MiniMax（必填）----
MINIMAX_API_KEY=sk-api-xxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ---- 存储 ----
# seekdb（评测要求）/ sqlite（无 seekdb 内核时的本地兜底）
SDDCTX_STORE=seekdb
SDDCTX_SEEKDB_PATH=.sddctx/seekdb
SDDCTX_SEEKDB_DATABASE=sddctx
# off = 只用全文检索；default = 额外启用向量近邻（首次会下载 embedding 模型）
SDDCTX_SEEKDB_EMBEDDING=off

# ---- PowerContext ----
POWERCONTEXT_URL=http://127.0.0.1:8077
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE_ID=
